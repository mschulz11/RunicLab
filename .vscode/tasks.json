{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-windows",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "src/RunicLab/RunicLab.csproj",
        "-f",
        "net10.0-windows10.0.19041.0"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-android",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "src/RunicLab/RunicLab.csproj",
        "-f",
        "net10.0-android"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "tests/RunicLab.Tests/RunicLab.Tests.csproj"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "format",
      "type": "process",
      "command": "dotnet",
      "args": ["format", "RunicLab.slnx"],
      "problemMatcher": []
    }
  ]
}
