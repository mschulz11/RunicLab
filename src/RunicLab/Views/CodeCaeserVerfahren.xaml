<?xml version="1.0" encoding="utf-8" ?>
<views:CipherPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:views="clr-namespace:RunicLab.Views"
                      x:Class="RunicLab.Views.CodeCaeserVerfahren"
                      Title="Cäser-Verfahren">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="20">

            <Label
                Style="{StaticResource SubHeadline}"
                Text="Das Cäser-Verfahren"
                SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Das Caesar-Verfahren, auch bekannt als Cäsar-Chiffre, ist ein einfaches symmetrisches Verschlüsselungsverfahren, das auf der Verschiebung des Alphabets basiert." />

            <Label
                Style="{StaticResource SubHeadline}"
                Text="Funktionsweise"
                SemanticProperties.HeadingLevel="Level2" />

            <Label Text="Die Cäsar-Chiffre funktioniert durch die Verschiebung der Buchstaben im Alphabet um eine feste Anzahl von Positionen. Zum Beispiel, bei einer Verschiebung um drei Stellen wird der Buchstabe 'A' zu 'D', 'B' zu 'E' und so weiter. Wenn das Ende des Alphabets erreicht wird, wird die Zählung wieder am Anfang fortgesetzt. Dies bedeutet, dass 'Z' bei einer Verschiebung um drei zu 'C' wird." />

            <!-- Eingabe, Aktions-Button und Ergebnis: gemeinsamer Block aller Verfahren -->
            <views:CipherEingabe x:Name="CipherEingabeControl" />

        </VerticalStackLayout>
    </ScrollView>

</views:CipherPageBase>
