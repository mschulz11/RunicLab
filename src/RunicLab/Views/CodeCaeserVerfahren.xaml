<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunicLab.Views.CodeCaeserVerfahren"
             Title="Cäser-Verfahren">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Einstellungen"
                     IconImageSource="playbutton1.png"
                     Order="Primary"
                     Priority="0"
                     Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label Text="Das Caesar-Verfahren, auch bekannt als Cäsar-Chiffre, ist ein einfaches symmetrisches Verschlüsselungsverfahren, das auf der Verschiebung des Alphabets basiert." />
            <Label
                Style="{StaticResource SubHeadline}"
                Text="Funktionsweise" />
            <Label Text="Die Cäsar-Chiffre funktioniert durch die Verschiebung der Buchstaben im Alphabet um eine feste Anzahl von Positionen. Zum Beispiel, bei einer Verschiebung um drei Stellen wird der Buchstabe 'A' zu 'D', 'B' zu 'E' und so weiter. Wenn das Ende des Alphabets erreicht wird, wird die Zählung wieder am Anfang fortgesetzt. Dies bedeutet, dass 'Z' bei einer Verschiebung um drei zu 'C' wird."></Label>
            <Border
                Stroke="Gray"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="10">
                <Editor
                    x:Name="quellText"
                    Placeholder="Text hier eingeben..."
                    HeightRequest="120" />
            </Border>

            <Label
                x:Name="lbModusAnzeige"
                FontSize="12"
                TextColor="Gray"
                HorizontalOptions="Center"
                Text="Modus: Verschlüsseln (änderbar in den Einstellungen)" />

            <Button
                x:Name="btnAktion"
                Text="Verschlüsseln"
                Clicked="OnAktionClicked"
                HorizontalOptions="Fill" />

            <Border
                Stroke="Gray"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="10">
                <Label
                    x:Name="zielText"
                    Text=""
                    FontSize="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
