<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="RunicLab.Views.SettingsCaeser"
            Title="Einstellungen"
            NavigationPage.HasNavigationBar="False"
            SizeChanged="OnPageSizeChanged">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Einstellungen"
                    IconImageSource="playbutton2.png"
                    Order="Primary"
                    Priority="0"
                    Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <Grid x:Name="RootGrid"
              Padding="12,8"
              RowSpacing="12"
              ColumnSpacing="12"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*">

            <!-- Karte 1: Verschiebung + Modus -->
            <Border x:Name="CardShift"
                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    BackgroundColor="Transparent"
                    Stroke="Gray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="16,12">
                <VerticalStackLayout Spacing="12">

                    <Label x:Name="lbVerschiebung"
                           FontSize="18"
                           FontAttributes="Bold"
                           Text="Verschiebung" />

                    <Label x:Name="lbVerschiebungHinweis"
                           FontSize="12"
                           TextColor="Gray"
                           Text="Anzahl der Stellen, um die das Alphabet verschoben wird (0–26)." />

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <Entry x:Name="entryVerschiebung"
                               Grid.Column="0"
                               Keyboard="Numeric"
                               Placeholder="3"
                               HorizontalTextAlignment="Center"
                               TextChanged="OnEntryVerschiebung" />
                        <Stepper x:Name="stepVerschiebung"
                                 Grid.Column="1"
                                 Increment="1"
                                 VerticalOptions="Center"
                                 ValueChanged="OnStepVerschiebung" />
                    </Grid>

                    <Slider x:Name="sliderVerschiebung"
                            ValueChanged="OnSliederVerschiebung" />

                    <BoxView HeightRequest="1" Color="Gray" Opacity="0.3" Margin="0,4" />

                    <Label x:Name="lbModus"
                           FontSize="18"
                           FontAttributes="Bold"
                           Text="Modus" />

                    <Label x:Name="lbModusHinweis"
                           FontSize="12"
                           TextColor="Gray"
                           Text="Legt fest, ob der eingegebene Text verschlüsselt oder entschlüsselt wird." />

                    <Grid x:Name="ModusGrid"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="8">
                        <RadioButton x:Name="rbVerschluesseln"
                                     Grid.Column="0"
                                     Content="Verschlüsseln"
                                     GroupName="caeserModus"
                                     CheckedChanged="OnModusChanged" />
                        <RadioButton x:Name="rbEntschluesseln"
                                     Grid.Column="1"
                                     Content="Entschlüsseln"
                                     GroupName="caeserModus"
                                     CheckedChanged="OnModusChanged" />
                    </Grid>

                    <Label x:Name="lbSicherheitsHinweis"
                           FontSize="12"
                           TextColor="Gray"
                           Text="Hinweis: Das Cäsar-Verfahren ist keine sichere Verschlüsselung – es dient nur zum Lernen und Ausprobieren." />

                    <Button x:Name="btnSchliessen"
                            Text="Schließen"
                            Clicked="OnCloseClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Karte 2: Beispiel-Alphabet -->
            <Border x:Name="CardExample"
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    BackgroundColor="Transparent"
                    Stroke="Gray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="16,12">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="lbVerschiebBeispiel"
                           FontSize="18"
                           FontAttributes="Bold"
                           Text="Beispiel-Verschiebung" />

                    <Label x:Name="lbBeispielHinweis"
                           FontSize="12"
                           TextColor="Gray"
                           Text="Zeigt für jeden Buchstaben das Ergebnis der aktuellen Einstellung." />

                    <ScrollView Orientation="Horizontal">
                        <Grid x:Name="AlphabetGrid"
                              Padding="4"
                              ColumnSpacing="10"
                              RowSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>

</ContentPage>
