<?xml version="1.0" encoding="utf-8" ?>
<views:CipherPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:views="clr-namespace:RunicLab.Views"
                      x:Class="RunicLab.Views.CodePolybius"
                      Title="Polybius-Quadrat">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="20">

            <Label Style="{StaticResource SubHeadline}"
                   Text="Polybius-Quadrat"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Das Polybius-Quadrat verteilt die Buchstaben des Alphabets auf ein 5×5-Gitter. Jeder Buchstabe wird nicht mehr als Buchstabe übertragen, sondern als Zahlenpaar aus Zeile und Spalte – das „A“ ist 11, das „B“ 12 und so weiter." />

            <Label Style="{StaticResource SubHeadline}"
                   Text="Funktionsweise"
                   SemanticProperties.HeadingLevel="Level2" />

            <Label Text="Weil 5×5 nur 25 Felder hat, teilen sich „I“ und „J“ ein Feld. Beim Verschlüsseln wird jeder Buchstabe zu zwei Ziffern: erst die Zeile, dann die Spalte. Beim Entschlüsseln liest man das Zahlenpaar in derselben Reihenfolge wieder aus dem Gitter. Umlaute werden vorher umschrieben (Ä→AE, Ö→OE, Ü→UE, ß→SS), Groß- und Kleinschreibung spielt keine Rolle." />

            <Label Style="{StaticResource SubHeadline}"
                   Text="Geschichte"
                   SemanticProperties.HeadingLevel="Level2" />

            <Label Text="Die Idee stammt aus dem 2. Jahrhundert vor Christus: Der griechische Historiker Polybios beschreibt in seinen „Historien“ ein Verfahren, mit dem Zeichen über weite Entfernungen per Fackelsignal übertragen werden konnten – für jede Zeile und Spalte eine Fackel links und rechts. Das Zahlenpaar-Prinzip lebt bis heute in modernen Verfahren weiter, etwa in der ADFGX-Chiffre des Ersten Weltkriegs." />

            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Gitter"
                           FontAttributes="Bold"
                           FontSize="16" />
                    <Grid x:Name="SquareGrid"
                          ColumnSpacing="6"
                          RowSpacing="6" />
                </VerticalStackLayout>
            </Border>

            <!-- Eingabe, Aktions-Button und Ergebnis: gemeinsamer Block aller Verfahren -->
            <views:CipherEingabe x:Name="CipherEingabeControl" />

            <Label FontSize="12"
                   TextColor="Gray"
                   Text="Hinweis: Beim Entschlüsseln gehen die Wortgrenzen des Originals verloren – die Koordinaten ergeben eine durchgehende Buchstabenfolge." />

        </VerticalStackLayout>
    </ScrollView>

</views:CipherPageBase>
