<?xml version="1.0" encoding="utf-8" ?>
<views:CipherPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:views="clr-namespace:RunicLab.Views"
                      x:Class="RunicLab.Views.CodeAlKindi"
                      Title="Häufigkeitsanalyse">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="20">

            <Label Style="{StaticResource SubHeadline}"
                   Text="Al-Kindi und die Häufigkeitsanalyse"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Nicht jede Verschlüsselung muss „geknackt“ werden, indem man alle Möglichkeiten durchprobiert. Man kann auch die Sprache selbst befragen: In jedem längeren Text kommen manche Buchstaben viel häufiger vor als andere. Diesen Umweg über die Statistik hat der arabische Gelehrte Al-Kindi im 9. Jahrhundert systematisch beschrieben – es ist der erste bekannte Text über Kryptoanalyse." />

            <Label Style="{StaticResource SubHeadline}"
                   Text="Geschichte"
                   SemanticProperties.HeadingLevel="Level2" />

            <Label Text="Abu Yusuf Yaqub ibn Ishaq al-Kindi (um 801–873) wirkte in Bagdad und schrieb die Abhandlung „Risala fi Istikhraj al-Mu'amma“ („Schrift über die Entzifferung verschlüsselter Botschaften“). Seine Beobachtung: In einer Sprache hat jeder Buchstabe eine typische Häufigkeit. Zählt man in einem Geheimtext die Zeichen, verrät deren Verteilung die Zuordnung – damit waren einfache Substitutions-Chiffren erstmals systematisch angreifbar." />

            <Label Style="{StaticResource SubHeadline}"
                   Text="Funktionsweise"
                   SemanticProperties.HeadingLevel="Level2" />

            <Label Text="Die App zählt alle Buchstaben des eingegebenen Textes und zeigt die häufigsten mit Balken und Prozentanteil. Besteht die Eingabe aus Zahlenpaaren (Polybius), zählt sie stattdessen die Paare selbst: In einem deutschen Text kommt das E am häufigsten vor, also ist auch das Koordinatenpaar am häufigsten, das für das E steht. Aus dieser Reihenfolge baut die App ein eigenes Gitter – das häufigste Paar bekommt das E, das zweithäufigste das N und so weiter. Felder, deren Paar zu selten vorkommt, bleiben offen und stehen im entschlüsselten Text als „?“. Diese Zuordnung ist eine begründete Vermutung, keine Gewissheit: Häufige Buchstaben trifft sie meist, seltene fast nie. Ein in den Einstellungen hinterlegtes Lösungswort wird dafür nicht benutzt. Für kurze Texte ist das unzuverlässig: Erst ab etwa 20 Buchstaben oder Koordinatenpaaren wird gerechnet." />

            <Label Style="{StaticResource SubHeadline}"
                   Text="Verfahrensvergleich"
                   SemanticProperties.HeadingLevel="Level2" />

            <Label Text="Man muss nicht wissen, womit verschlüsselt wurde: Der Vergleich probiert alle Verfahren der App blind durch – unveränderten Text, alle 26 Cäsar-Verschlüsselungen und, wenn die Eingabe aus Zahlenpaaren besteht, das Polybius-Quadrat (mit Standardgitter und mit dem eingestellten Schlüsselwort). Jeder entstehende Text wird mit der typischen Buchstabenverteilung verglichen (Chi-Quadrat, kleiner ist besser) und die Kandidaten werden sortiert. Bei einem Polybius-Text mit fremdem Schlüsselwort kann der Vergleich das Gitter nicht erraten – dann bleibt nur der Hinweis, dass es Koordinaten sind. Deshalb arbeitet die Häufigkeitsanalyse oben unabhängig davon: Sie baut ihr Gitter allein aus den gezählten Paaren." />

            <!-- Eingabe und Aktions-Button: gemeinsamer Block aller Verfahren.
                 Die Auswertung hat keinen einfachen Ausgabetext, daher wird der
                 Standard-Ergebnisrahmen ausgeblendet (siehe Code-Behind). -->
            <views:CipherEingabe x:Name="CipherEingabeControl" />

            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Buchstabenhäufigkeit"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <Label x:Name="lbZusammenfassung"
                           FontSize="12"
                           TextColor="Gray"
                           Text="Noch keine Analyse." />

                    <Grid x:Name="ResultGrid"
                          ColumnSpacing="10"
                          RowSpacing="6" />
                </VerticalStackLayout>
            </Border>

            <!-- Gitter nur zeigen, wenn aus Zahlenpaaren ein Gitter erschlossen wurde (#32) -->
            <Border x:Name="GitterKarte"
                    Stroke="Gray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12"
                    IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Aus der Häufigkeit erschlossenes Gitter"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <Label x:Name="lbGitterHinweis"
                           FontSize="12"
                           TextColor="Gray"
                           Text="" />

                    <Grid x:Name="GitterRaster"
                          ColumnSpacing="6"
                          RowSpacing="6" />

                    <Label Text="So liest sich der Text mit dieser Zuordnung („?“ = offen)"
                           FontAttributes="Bold"
                           FontSize="14" />

                    <Label x:Name="lbHypotheseText"
                           FontSize="14"
                           LineBreakMode="WordWrap"
                           Text="" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Verfahrensvergleich"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <Label x:Name="lbVergleichHinweis"
                           FontSize="12"
                           TextColor="Gray"
                           Text="Noch kein Vergleich – Text analysieren." />

                    <VerticalStackLayout x:Name="VergleichListe"
                                         Spacing="10" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</views:CipherPageBase>
