root = true

# Basis für alle Dateien
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# YAML/Markdown/JSON: 2 Leerzeichen, Zeilenenden LF (Tooling-freundlich)
[*.{yml,yaml,md,json,jsonc}]
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = false

[*.{csproj,props,targets,slnx,xml,xaml}]
indent_style = space
indent_size = 2

[*.sh]
end_of_line = lf
indent_size = 2

# C#: Namens- und Stilregeln, die die CI nicht erzwingt, aber der Editor respektiert
[*.cs]
indent_size = 4

# using-Direktiven
dotnet_sort_system_directives_first = true

# Sprachfeatures
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:suggestion

# Modifier-Reihenfolge / Lesbarkeit
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,override,async,unsafe,volatile:suggestion

# Diagnose-Schweregrade
dotnet_diagnostic.CA1416.severity = none
dotnet_diagnostic.CA1848.severity = suggestion

# Generated
[**/obj/**,**/bin/**]
generated_code = true
